<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Viset</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="EmbeddedText.fs" />
    <Compile Include="TomlValue.fs" />
    <Compile Include="Device.fs" />
    <Compile Include="Frames.fs" />
    <Compile Include="MediaModel.fs" />
    <Compile Include="Browser.fs" />
    <Compile Include="CapturePlan.fs" />
    <Compile Include="Metrics.fs" />
    <Compile Include="CaptureResult.fs" />
    <Compile Include="PerformanceMetrics.fs" />
    <Compile Include="BuiltInFrames.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
