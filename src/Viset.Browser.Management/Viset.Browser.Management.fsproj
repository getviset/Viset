<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Viset</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BrowserTypes.fs" />
    <Compile Include="BrowserRuntime.fs" />
    <Compile Include="BrowserLockContract.fs" />
    <Compile Include="BrowserCache.fs" />
    <Compile Include="BrowserValidation.fs" />
    <Compile Include="BrowserDiscovery.fs" />
    <Compile Include="BrowserDownload.fs" />
    <Compile Include="BrowserArchive.fs" />
    <Compile Include="BrowserInstaller.fs" />
    <Compile Include="BrowserResolution.fs" />
    <Compile Include="BrowserInstall.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viset.Core\Viset.Core.fsproj" />
    <ProjectReference Include="..\Viset.Serialization\Viset.Serialization.csproj" />
  </ItemGroup>
</Project>
