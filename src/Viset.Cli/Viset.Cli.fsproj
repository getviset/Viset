<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>viset</AssemblyName>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Command.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="EditorSupport.fs" />
    <Compile Include="EmbeddedText.fs" />
    <Compile Include="ScaffoldAssets.fs" />
    <Compile Include="ScaffoldFileSystem.fs" />
    <Compile Include="ScaffoldValidation.fs" />
    <Compile Include="ScaffoldInput.fs" />
    <Compile Include="ScaffoldContent.fs" />
    <Compile Include="Scaffold.fs" />
    <Compile Include="CliOutput.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="../assets/Scaffold/default.html"
      LogicalName="Viset.Scaffold.DefaultPage.html"
    />
    <EmbeddedResource
      Include="../assets/Scaffold/capture.lua"
      LogicalName="Viset.Scaffold.Capture.lua"
    />
    <EmbeddedResource
      Include="../assets/Scaffold/README.md"
      LogicalName="Viset.Scaffold.Readme.md"
    />
    <EmbeddedResource
      Include="../assets/.luarc.json"
      LogicalName="Viset.EditorSupport.luarc.json"
    />
    <EmbeddedResource
      Include="../assets/.viset/viset.d.lua"
      LogicalName="Viset.EditorSupport.viset.d.lua"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="../../browser-lock.toml"
      Link="browser-lock.toml"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viset.Core\Viset.Core.fsproj" />
    <ProjectReference Include="..\Viset.CaptureScript\Viset.CaptureScript.fsproj" />
    <ProjectReference Include="..\Viset.Browser.Management\Viset.Browser.Management.fsproj" />
    <ProjectReference Include="..\Viset.Capture\Viset.Capture.fsproj" />
  </ItemGroup>
</Project>
