<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="RecordingStateTests.fs" />
    <Compile Include="RecordingTimelineTests.fs" />
    <Compile Include="FrameCoalescingTests.fs" />
    <Compile Include="WebPContainerTests.fs" />
    <Compile Include="PerformanceMetricsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>


<ItemGroup>
  <ProjectReference Include="..\..\src\Viset.Core\Viset.Core.fsproj" />
  <ProjectReference Include="..\..\src\Viset.WebP\Viset.WebP.fsproj" />
  <ProjectReference Include="..\..\src\Viset.Capture\Viset.Capture.fsproj" />
</ItemGroup>
</Project>
